# Server
PORT=3000
NODE_ENV=development

# Database (SQL Server via Prisma)
DATABASE_URL="sqlserver://localhost:1433;database=InventoryDb;user=sa;password=YOUR_PASSWORD_HERE;encrypt=true;trustServerCertificate=true;"

# Frontend origins allowed by CORS. Comma-separated; no wildcards.
FRONTEND_ORIGIN=http://localhost:4200
FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Auth — separate secrets per token kind so a leak of one does not let an
# attacker mint the others. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production the app refuses to boot if any of these is missing or still set
# to its shipped development default.
JWT_ACCESS_SECRET=change-me-to-a-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-random-refresh-secret
JWT_MFA_SECRET=change-me-to-a-random-mfa-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_MFA_EXPIRES_IN=5m

# Cookie flags
# `Secure` cookies are only delivered over HTTPS, so this defaults to on in
# production and off elsewhere. Set it explicitly for any other environment
# served over HTTPS (for example staging behind a TLS proxy).
# COOKIE_SECURE=true
