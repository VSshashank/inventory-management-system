    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.1",
