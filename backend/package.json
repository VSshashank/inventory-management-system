{
  "name": "inventory-pro-backend",
  "version": "1.0.0",
  "description": "Inventory Management System — Express + TypeScript API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
